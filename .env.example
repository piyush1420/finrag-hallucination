# Copy this file to `.env` and fill in your own values.
# NEVER commit the real `.env` — it is gitignored.

# OpenAI API key (used by GPT-3.5-turbo generator + query rewriting + RAGAS)
OPENAI_API_KEY=sk-...

# Optional: HuggingFace token (needed to download some gated models, e.g. Mistral)
HUGGINGFACE_TOKEN=hf_...

# Optional: model + run defaults (can also be set per-run in code)
OPENAI_MODEL=gpt-3.5-turbo
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- LLM backend ---
# Which backend the generator + RAGAS judge use: "ollama" (local, default, no key)
# or "openai" (hosted, needs OPENAI_API_KEY above).
LLM_BACKEND=ollama
# Where the local Ollama server listens (OpenAI-compatible endpoint).
OLLAMA_BASE_URL=http://localhost:11434/v1
